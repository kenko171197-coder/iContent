 },
 "events": [
  {
   "start": 0.25,
   "end": 1.75,
   "text": "丧彪別闹"
  },
  {
   "start": 3.0,
   "end": 5.25,
   "text": "彪大清早你发什么神经"
  },
  {
   "start": 11.5,
   "end": 13.25,
   "text": "丧彪你要造反呀"
  },
  {
   "start": 16.75,
   "end": 17.75,
   "text": "奶奶怎么了"
  },
  {
   "start": 18.0,
   "end": 19.5,
   "text": "你让让我看不见"
  },
  {
   "start": 19.5,
   "end": 21.0,
   "text": "哼上一边去"
  },
  {
   "start": 21.25,
   "end": 22.75,
   "text": "丧彪"
  },
  {
   "start": 22.75,
   "end": 23.75,
   "text": "丧彪老头子"
  },
  {
   "start": 23.75,
   "end": 24.5,
   "text": "你倒好彪"
  },
  {
   "start": 24.5,
   "end": 25.75,
   "text": "夹彪往墙上一挂"
  },
  {
   "start": 27.0,
   "end": 28.25,
   "text": "彪留我一个人"
  },
  {
   "start": 28.25,
   "end": 30.0,
   "text": "连个拌嘴的都没有"
  },
  {
   "start": 30.75,
   "end": 33.0,
   "text": "丧彪奶奶太可怜了"
  },
  {
   "start": 33.25,
   "end": 34.5,
   "text": "丧彪你是狗"
  },
  {
   "start": 34.5,
   "end": 35.75,
   "text": "不能当我爷爷"
  },
  {
   "start": 37.5,
   "end": 40.25,
   "text": "你是说给奶奶找个老伴"
  },
  {
   "start": 40.5,
   "end": 42.25,
   "text": "走找老许去"
  },
  {
   "start": 42.25,
   "end": 43.75,
   "text": "村里就他一个老光棍"
  },
  {
   "start": 43.75,
   "end": 44.75,
   "text": "找他准没错"
  },
  {
   "start": 48.75,
   "end": 50.25,
   "text": "呦还有两只羊呢"
  },
  {
   "start": 52.0,
   "end": 53.5,
   "text": "哎这羊还挺有礼貌"
  },
  {
   "start": 53.5,
   "end": 54.75,
   "text": "跟咱鞠躬呢"
  },
  {
   "start": 56.75,
   "end": 58.25,
   "text": "妈呀这羊疯了"
  },
  {
   "start": 58.25,
   "end": 59.75,
   "text": "羊大哥误会"
  },
  {
   "start": 59.75,
   "end": 61.25,
   "text": "我们就是来找个人的"
  },
  {
   "start": 61.25,
   "end": 62.0,
   "text": "丧彪"
  },
  {
   "start": 62.5,
   "end": 63.5,
   "text": "哎呦"
  },
  {
   "start": 64.5,
   "end": 66.25,
   "text": "丧彪你不是狗吗"
  },
  {
   "start": 66.25,
   "end": 67.5,
   "text": "你跟它说两句啊"
  },
  {
   "start": 67.5,
   "end": 69.25,
   "text": "这羊也太不讲理了"
  },
  {
   "start": 69.25,
   "end": 70.5,
   "text": "咱们那么有礼貌"
  },
  {
   "start": 70.5,
   "end": 71.5,
   "text": "它上来就顶"
  },
  {
   "start": 71.75,
   "end": 73.25,
   "text": "对啊找你二舅去"
  },
  {
   "start": 73.25,
   "end": 74.25,
   "text": "你二舅点子多"
  },
  {
   "start": 75.0,
   "end": 76.5,
   "text": "丧彪快跟上"
  },
  {
   "start": 81.25,
   "end": 82.75,
   "text": "二舅帮帮忙吧"
  },
  {
   "start": 85.25,
   "end": 87.0,
   "text": "二舅靠谱吗"
  },
  {
   "start": 90.75,
   "end": 92.0,
   "text": "你二舅啥意思"
  },
  {
   "start": 103.25,
   "end": 104.0,
   "text": "这这也行彪"
  },
  {
   "start": 104.75,
   "end": 106.25,
   "text": "丧彪"
  },
  {
   "start": 107.25,
   "end": 108.0,
   "text": "干啥的"
  },
  {
   "start": 108.25,
   "end": 110.25,
   "text": "老许你要老婆不要"
  },
  {
   "start": 111.25,
   "end": 112.0,
   "text": "谁家姑娘"
  },
  {
   "start": 113.5,
   "end": 114.5,
   "text": "屋军新"
  },
  {
   "start": 115.75,
   "end": 117.25,
   "text": "哎呦这姑娘俊"
  },
  {
   "start": 117.5,
   "end": 119.0,
   "text": "走走走现在就去"
  },
  {
   "start": 119.0,
   "end": 121.0,
   "text": "大妹子你女儿呢"
  },
  {
   "start": 121.25,
   "end": 122.5,
   "text": "快把你女儿带出来"
  },
  {
   "start": 125.75,
   "end": 126.75,
   "text": "啥女儿"
  },
  {
   "start": 128.0,
   "end": 130.0,
   "text": "乃奶这是给您找的老伴"
  },
  {
   "start": 132.25,
   "end": 133.5,
   "text": "你俩诈骗呢"
  },
  {
   "start": 133.75,
   "end": 135.5,
   "text": "嘿嘿大爷您听我说"
  },
  {
   "start": 136.0,
   "end": 138.0,
   "text": "哎老点也行吧"
  },
  {
   "start": 138.5,
   "end": 140.75,
   "text": "奶奶您就聊两句嘛"
  },
  {
   "start": 140.75,
   "end": 142.0,
   "text": "丧彪人家都来了"
  },
  {
   "start": 142.25,
   "end": 143.75,
   "text": "丧彪我呢条件一般"
  },
  {
   "start": 143.75,
   "end": 144.75,
   "text": "但人实在"
  },
  {
   "start": 144.75,
   "end": 145.75,
   "text": "虽然不愿意多花钱"
  },
  {
   "start": 145.75,
   "end": 148.0,
   "text": "立点心但是我会对你好"
  },
  {
   "start": 148.0,
   "end": 149.5,
   "text": "西北风先紧着我喝吗"
  },
  {
   "start": 149.5,
   "end": 150.25,
   "text": "我丑话说在前头"
  },
  {
   "start": 150.25,
   "end": 150.75,
   "text": "嫁到我家"
  },
  {
   "start": 150.75,
   "end": 152.25,
   "text": "你不能上桌吃饭"
  },
  {
   "start": 152.5,
   "end": 153.75,
   "text": "桌子都买不起吗"
  },
  {
   "start": 154.5,
   "end": 156.0,
   "text": "大妹子我这人还浪漫"
  },
  {
   "start": 156.0,
   "end": 157.25,
   "text": "你知道我想变成啥不"
  },
  {
   "start": 157.25,
   "end": 158.25,
   "text": "我想变成一匹马"
  },
  {
   "start": 158.25,
   "end": 159.75,
   "text": "因为想听到你说一句嫁"
  },
  {
   "start": 160.0,
   "end": 161.5,
   "text": "哈哈哈"
  },
  {
   "start": 161.5,
   "end": 163.25,
   "text": "我让你变马"
  },
  {
   "start": 163.25,
   "end": 164.25,
   "text": "你给我出去"
  },
  {
   "start": 166.75,
   "end": 168.0,
   "text": "笑还笑"
  },
  {
   "start": 168.0,
   "end": 169.25,
   "text": "你俩给我起来"
  },
  {
   "start": 169.5,
   "end": 170.75,
   "text": "你俩长本事了"
  },
  {
   "start": 172.0,
   "end": 174.0,
   "text": "奶奶是丧彪先提的"
  },
  {
   "start": 174.5,
   "end": 175.75,
   "text": "你俩都给我闭嘴"
  },
  {
   "start": 178.0,
   "end": 179.75,
   "text": "哎呦气死我了"
  },
  {
   "start": 183.0,
   "end": 184.5,
   "text": "丧彪"
  },
  {
   "start": 185.0,
   "end": 186.5,
   "text": "二舅还在跑呢"
  },
  {
   "start": 186.5,
   "end": 187.0,
   "text": "丧彪"
  },
  {
   "start": 189.25,
   "end": 192.0,
   "text": "我们不能辜负二舅的努力"
  },
  {
   "start": 192.25,
   "end": 194.75,
   "text": "你是说把爷爷请回来"
  },
  {
   "start": 197.25,
   "end": 198.0,
   "text": "嗯嗯"
  },
  {
   "start": 198.75,
   "end": 200.75,
   "text": "翠花我来看你了"
  },
  {
   "start": 202.5,
   "end": 203.75,
   "text": "米粒大晚上搞什么鬼"
  },
  {
   "start": 203.75,
   "end": 205.25,
   "text": "乃奶我把爷爷带回来了"
  },
  {
   "start": 205.25,
   "end": 206.25,
   "text": "你放什么屁"
  },
  {
   "start": 208.75,
   "end": 210.0,
   "text": "我让你带回来"
  },
  {
   "start": 210.0,
   "end": 211.0,
   "text": "我让你贴照片"
  },
  {
   "start": 211.0,
   "end": 212.5,
   "text": "你俩今晚别跑"
  },
  {
   "start": 212.75,
   "end": 214.0,
   "text": "翠花我回来看你"
  },
  {
   "start": 214.0,
   "end": 214.75,
   "text": "你还要打我"
  },
  {
   "start": 214.75,
   "end": 216.0,
   "text": "你还敢喊我名字"
  },
  {
   "start": 216.0,
   "end": 217.25,
   "text": "丧彪我都说了"
  },
  {
   "start": 217.25,
   "end": 218.5,
   "text": "你不能当我爷爷"
  }
 ]
}